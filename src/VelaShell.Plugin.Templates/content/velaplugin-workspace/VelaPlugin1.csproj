<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VelaAvaloniaVersion>AVALONIA_VERSION</VelaAvaloniaVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001:面板视图刻意只有带文档的构造(由 IWorkspaceDocument.CreateView 创建),
         不走运行时 XAML 装载器的无参构造路径。 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <!-- 测试工程与本机试跑用的回显服务就放在工程目录里:别让默认通配把它们的源码
         (以及测试工程的 bin/obj)编进插件。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);VelaPlugin1.Tests/**;tools/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 由目标宿主选版,保留 AXAML 的编译与构建资产,运行时由宿主共享。 -->
    <PackageReference Include="Avalonia" Version="$(VelaAvaloniaVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="VelaShell.PluginSdk.Build" Version="SDK_VERSION" />
  </ItemGroup>

  <ItemGroup>
    <!-- 单测直接驱动内部类型(设置解析、文档、状态存取)。 -->
    <InternalsVisibleTo Include="VelaPlugin1.Tests" />
  </ItemGroup>

</Project>
